[Unit]
Description=MQTT to SmartWeb bridge driver
After=network.target wb-hwconf-manager.service wb-modules.service mosquitto.service

[Service]
Type=simple
Restart=on-failure
RestartSec=1
User=root
ExecStart=/usr/bin/wb-mqtt-smartweb -c /etc/wb-mqtt-smartweb.conf
RestartPreventExitStatus=2 6
SuccessExitStatus=7

[Install]
WantedBy=multi-user.target